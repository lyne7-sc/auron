Subject: [PATCH] auron: preserve decimal scale in parquet dictionary pruning

Parquet integer dictionaries contain unscaled decimal values. Preserve the
logical precision and scale before the pruning statistics cast, so a value of
10.00 stored as 1000 is not incorrectly compared as 1000.00.

diff --git a/parquet/src/auron.rs b/parquet/src/auron.rs
index 2c86f045a1ec39b0d17c495059dce9491a7db2c5..16e7106b40afe117490bd600ded95a7812e85ea2 100644
--- a/parquet/src/auron.rs
+++ b/parquet/src/auron.rs
@@ -94,9 +94,22 @@ pub fn get_dictionary_for_pruning<T: AsyncFileReader + Send + 'static>(
                         column_metadata.column_descr().type_length());
                     dict_decoder.set_data(buf, num_values as usize)?;
                     dict_decoder.get(&mut dict_values)?;
-                    Ok(Some(
-                        Arc::new(<$array_type>::from_iter_values(dict_values))
-                    ))
+                    let array: ArrayRef =
+                        Arc::new(<$array_type>::from_iter_values(dict_values));
+                    let descriptor = column_metadata.column_descr();
+                    if descriptor.converted_type() == crate::basic::ConvertedType::DECIMAL {
+                        // Dictionary integers are unscaled decimal values. Attach the file
+                        // scale after widening, rather than numerically casting to that scale.
+                        let decimal = arrow_cast::cast(&array, &DataType::Decimal128(38, 0))?;
+                        let decimal = Decimal128Array::from(decimal.to_data())
+                            .with_precision_and_scale(
+                                descriptor.type_precision() as u8,
+                                descriptor.type_scale() as i8,
+                            )?;
+                        Ok(Some(Arc::new(decimal) as ArrayRef))
+                    } else {
+                        Ok(Some(array))
+                    }
                 }
                 _ => {
                     Ok(None)
