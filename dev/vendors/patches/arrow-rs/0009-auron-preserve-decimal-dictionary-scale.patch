+    fn check_decimal_dictionary<T: crate::data_type::DataType>(
+        precision: u8,
+        values: &[T::T],
+        expected: &[i128],
+    ) -> crate::errors::Result<()> {
+        use crate::basic::{Encoding, PageType};
+        use crate::column::page::{CompressedPage, Page, PageWriter};
+        use crate::encodings::encoding::{Encoder, PlainEncoder};
+        use crate::file::metadata::{ColumnChunkMetaData, RowGroupMetaData};
+        use crate::file::page_encoding_stats::PageEncodingStats;
+        use crate::file::writer::{SerializedPageWriter, TrackedWrite};
+        use crate::schema::{parser::parse_message_type, types::SchemaDescriptor};
+        use arrow_array::Decimal128Array;
+
+        let schema = Arc::new(SchemaDescriptor::new(Arc::new(parse_message_type(
+            &format!(
+                "message schema {{ REQUIRED {} amount (DECIMAL({precision}, 2)); }}",
+                T::get_physical_type(),
+            ),
+        )?)));
+        let mut encoder = PlainEncoder::<T>::new();
+        encoder.put(values)?;
+        let encoded = encoder.flush_buffer()?;
+        let size = encoded.len();
+        let page = Page::DictionaryPage {
+            buf: encoded,
+            num_values: values.len() as u32,
+            encoding: Encoding::PLAIN_DICTIONARY,
+            is_sorted: false,
+        };
+        let mut file = tempfile::tempfile()?;
+        let mut sink = TrackedWrite::new(&mut file);
+        let spec = SerializedPageWriter::new(&mut sink).write_page(CompressedPage::new(page, size))?;
+        drop(sink);
+        let column = ColumnChunkMetaData::builder(schema.column(0))
+            .set_num_values(values.len() as i64)
+            .set_encodings(vec![Encoding::PLAIN_DICTIONARY])
+            .set_page_encoding_stats(vec![PageEncodingStats {
+                page_type: PageType::DICTIONARY_PAGE,
+                encoding: Encoding::PLAIN_DICTIONARY,
+                count: 1,
+            }])
+            .set_dictionary_page_offset(Some(0))
+            .set_total_compressed_size(spec.compressed_size as i64)
+            .set_total_uncompressed_size(spec.uncompressed_size as i64)
+            .build()?;
+        let row_group = RowGroupMetaData::builder(schema)
+            .set_num_rows(values.len() as i64)
+            .set_column_metadata(vec![column])
+            .build()?;
+        let dictionary = get_dictionary_for_pruning(&mut AsyncLocalFileReader(file), &row_group, 0)?
+            .expect("decimal dictionary must be available for pruning");
+        let data_type = DataType::Decimal128(precision, 2);
+        let cast_dictionary = cast(&dictionary, &data_type)?;
+        let decimals = cast_dictionary
+            .as_any()
+            .downcast_ref::<Decimal128Array>()
+            .unwrap();
+        assert_eq!(
+            decimals,
+            &Decimal128Array::from(expected.to_vec()).with_precision_and_scale(precision, 2)?,
+        );
+        assert_eq!(dictionary.data_type(), &data_type);
+        Ok(())
+    }
+
+    #[test]
+    fn test_decimal_int32_dictionary_scale() -> crate::errors::Result<()> {
+        check_decimal_dictionary::<crate::data_type::Int32Type>(
+            9,
+            &[-1025, 0, 1025, 999999999],
+            &[-1025, 0, 1025, 999999999],
+        )
+    }
+
+    #[test]
+    fn test_decimal_int64_dictionary_scale() -> crate::errors::Result<()> {
+        check_decimal_dictionary::<crate::data_type::Int64Type>(
+            18,
+            &[-1025, 0, 1025, 999999999999999999],
+            &[-1025, 0, 1025, 999999999999999999],
+        )
+    }
+
